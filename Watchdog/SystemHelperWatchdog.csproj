<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameHost</AssemblyName>
    <Company>DeviceMon</Company>
    <Product>GameHost</Product>
    <Description>Watchdog service for DeviceMon</Description>
    <AssemblyTitle>GameHost</AssemblyTitle>
    <Version>1.7.3</Version>
    <AssemblyVersion>1.7.3.0</AssemblyVersion>
    <FileVersion>1.7.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup><Compile Include="..\ScreenTime\*.cs" Link="ScreenTime\%(Filename)%(Extension)" /></ItemGroup>
</Project>
